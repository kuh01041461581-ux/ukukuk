+/// 투명색 색인이 표시된 8비트 BMP 이면 그 색인을 돌려준다.
+fn indexed_bmp_transparent_index(data: &[u8]) -> Option<u8> {
+    if data.len() < 54 || !data.starts_with(b"BM") || data[6..10] != [1, 0, 0, 0] || data[14..18] != [40, 0, 0, 0] || data[28..30] != [8, 0] {
+        return None;
+    }
+    let important = u32::from_le_bytes([data[50], data[51], data[52], data[53]]);
+    if important & !0xff == 0x100 {
+        return Some((important & 0xff) as u8);
+    }
+    if important < 256 {
+        // 색인만 적은 형태: 팔레트 범위 안일 때만 투명색으로 본다 (표준 BMP 의 '중요한 색 개수' 와 구분)
+        let used = u32::from_le_bytes([data[46], data[47], data[48], data[49]]);
+        let palette_len = if used == 0 { 256 } else { used.min(256) };
+        if important < palette_len {
+            return Some(important as u8);
+        }
+    }
+    None
+}
