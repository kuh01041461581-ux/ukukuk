+/// `ranges` 의 코드가 변환 당시 바이트(`images`)와 현재 메모리에서 같은지 확인한다. 하나라도 다르거나 읽을 수 없으면 false.
+fn code_matches(ranges: &[Range<u64>], images: &[CodeImage], memory: &EmulatedMemory) -> bool {
+    for range in ranges {
+        let mut address = range.start;
+        while address < range.end {
+            // images 는 주소 오름차순이고 서로 겹치지 않는다.
+            let Ok(index) = images.binary_search_by(|image| {
+                let start = u64::from(image.address);
+                let end = start + image.bytes.len() as u64;
+                if end <= address {
+                    core::cmp::Ordering::Less
+                } else if start > address {
+                    core::cmp::Ordering::Greater
+                } else {
+                    core::cmp::Ordering::Equal
+                }
+            }) else {
+                return false;
+            };
+            let image = &images[index];
+            let offset = (address - u64::from(image.address)) as usize;
+            let len = (image.bytes.len() - offset).min((range.end - address) as usize);
+            match memory.code_image(address as u32, len) {
+                Ok(current) if current.bytes[..] == image.bytes[offset..offset + len] => {}
+                _ => return false,
+            }
+            address += len as u64;
+        }
+    }
+    true
+}
