diff --git a/wie-web/src/css/style.css b/wie-web/src/css/style.css
index e178d36..1d3c380 100644
--- a/wie-web/src/css/style.css
+++ b/wie-web/src/css/style.css
@@ -923,3 +923,108 @@ kbd {
     scroll-behavior: auto;
   }
 }
+
+/* ===== 가상 패드 (터치 패드 / 피처폰 키패드) ===== */
+.pads {
+  width: min(100%, 480px);
+  padding: 8px 0 max(10px, env(safe-area-inset-bottom));
+  touch-action: none;
+  user-select: none;
+  -webkit-user-select: none;
+  -webkit-touch-callout: none;
+}
+.pad-tabs { display: flex; gap: 6px; margin-bottom: 8px; }
+.pad-tabs button {
+  flex: 1; height: 34px; border-radius: 8px; font-size: 0.85rem; font-weight: 600;
+  border: 1px solid #3a3a3a; background: #1b1b1b; color: #aaa;
+}
+.pad-tabs button[aria-selected="true"] { background: #2f6fed; border-color: #2f6fed; color: #fff; }
+
+.pads button[data-key], .pads .act, .pads .touch-numbers button {
+  touch-action: none; border: 1px solid #444; border-radius: 10px; color: #f2f2f2;
+  background: linear-gradient(#303030, #1e1e1e); font-weight: 700; font-size: 1rem;
+  box-shadow: 0 2px 0 #000; cursor: pointer;
+}
+.pads button[data-key]:active { background: #3c5fb5; transform: translateY(1px); }
+.pads button[data-key]:disabled { opacity: 0.45; }
+
+.touch-main { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 4px 6px; }
+.joystick {
+  position: relative; flex: 0 0 auto; width: min(44vw, 190px); aspect-ratio: 1; touch-action: none;
+}
+.joystick-ring {
+  position: absolute; inset: 0; border-radius: 50%;
+  background: radial-gradient(circle at 50% 50%, #262626 0 55%, #1a1a1a 56% 100%);
+  border: 2px solid #4a4a4a; box-shadow: inset 0 0 18px #000;
+}
+.joystick-ring::before, .joystick-ring::after {
+  content: ""; position: absolute; background: #3a3a3a; left: 50%; top: 8%; width: 2px; height: 84%; transform: translateX(-50%);
+}
+.joystick-ring::after { left: 8%; top: 50%; width: 84%; height: 2px; transform: translateY(-50%); }
+.joystick-stick {
+  position: absolute; left: 50%; top: 50%; width: 38%; height: 38%; margin: -19% 0 0 -19%; border-radius: 50%;
+  background: radial-gradient(circle at 35% 30%, #7aa2ff, #2f56c0 70%); box-shadow: 0 3px 8px #000; pointer-events: none;
+}
+.touch-actions { flex: 1 1 auto; display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; max-width: 220px; }
+.touch-actions .act { height: 52px; font-size: 0.9rem; }
+.touch-actions .act-ok { grid-column: 1 / -1; height: 64px; background: linear-gradient(#3b7bff, #2152c4); font-size: 1.15rem; }
+.touch-actions .act-num-toggle { background: #222; }
+.touch-numbers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-top: 8px; padding: 0 6px; }
+.touch-numbers button { height: 44px; }
+.touch-numbers[hidden] { display: none; }
+.pad[hidden] { display: none; }
+
+.phone-top { display: grid; grid-template-columns: 1fr auto 1fr; gap: 8px; align-items: center; padding: 0 6px; }
+.phone-side { display: grid; gap: 6px; }
+.phone-side .act { height: 46px; font-size: 0.9rem; }
+.phone-side .call { color: #5ee08a; }
+.dpad {
+  display: grid; grid-template-columns: repeat(3, 52px); grid-template-rows: repeat(3, 44px); gap: 3px;
+}
+.dpad .up { grid-area: 1 / 2; } .dpad .left { grid-area: 2 / 1; } .dpad .ok { grid-area: 2 / 2; }
+.dpad .right { grid-area: 2 / 3; } .dpad .down { grid-area: 3 / 2; }
+.dpad button { font-size: 0.95rem; }
+.phone-keys { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-top: 10px; padding: 0 6px; }
+.phone-keys button { height: 50px; display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: 1.1; }
+.phone-keys small { font-size: 0.55rem; font-weight: 400; color: #999; }
+
+/* ===== 방향 버튼(D-pad) · 조작 설정 · 키보드 안내 ===== */
+.pads, .pads * { -webkit-tap-highlight-color: transparent; }
+.pad-tabs .tab-gear { flex: 0 0 44px; font-size: 1.1rem; padding: 0; }
+.dir-wrap { display: flex; flex-direction: column; align-items: center; gap: 6px; flex: 0 0 auto; }
+.dir-toggle { height: 26px; padding: 0 10px; font-size: 0.7rem; border-radius: 13px; border: 1px solid #3a3a3a; background: #1b1b1b; color: #aaa; touch-action: manipulation; }
+.dpad-touch {
+  position: relative; width: min(44vw, 190px); aspect-ratio: 1; touch-action: none;
+  display: grid; grid-template-columns: 1fr 1fr 1fr; grid-template-rows: 1fr 1fr 1fr;
+  border-radius: 50%; background: radial-gradient(circle, #262626 0 60%, #1a1a1a 61% 100%); border: 2px solid #4a4a4a; box-shadow: inset 0 0 18px #000;
+}
+.dpad-touch[hidden] { display: none; }
+.dpad-touch i { display: flex; align-items: center; justify-content: center; font-style: normal; font-size: 1.5rem; color: #9aa4b8; pointer-events: none; transition: background 0.04s, color 0.04s; border-radius: 12px; margin: 4px; }
+.dpad-touch .u { grid-area: 1 / 2; } .dpad-touch .l { grid-area: 2 / 1; } .dpad-touch .c { grid-area: 2 / 2; background: #333; border-radius: 50%; }
+.dpad-touch .r { grid-area: 2 / 3; } .dpad-touch .d { grid-area: 3 / 2; }
+.dpad-touch[data-y="-1"] .u, .dpad-touch[data-y="1"] .d, .dpad-touch[data-x="-1"] .l, .dpad-touch[data-x="1"] .r { background: #3c5fb5; color: #fff; }
+.joystick[hidden] { display: none; }
+
+.controls-fields label { display: grid; gap: 4px; margin-bottom: 12px; font-size: 0.9rem; }
+.controls-fields label.inline { display: flex; align-items: center; gap: 8px; }
+.controls-fields output { float: right; color: var(--muted); }
+
+.key-help { width: min(100%, 480px); margin: 4px 0 16px; color: var(--fg); font-size: 0.85rem; }
+.key-help summary { cursor: pointer; padding: 8px 6px; font-weight: 700; }
+.key-help table { width: 100%; border-collapse: collapse; }
+.key-help th { text-align: left; white-space: nowrap; padding: 5px 10px 5px 6px; color: var(--muted); font-weight: 600; vertical-align: top; }
+.key-help td { padding: 5px 6px; line-height: 1.7; }
+.key-help kbd { display: inline-block; min-width: 1.6em; text-align: center; padding: 1px 6px; margin: 0 1px; border: 1px solid var(--border); border-bottom-width: 2px; border-radius: 5px; background: var(--card-bg); font: inherit; font-size: 0.8rem; }
+@media (pointer: coarse) { .key-help { display: none; } }
+
+/* PC 에서는 화면 버튼 아래에 대응하는 키보드 글자를 작게 표시 */
+@media (hover: hover) and (pointer: fine) {
+  .pads button[data-hint]::after { content: attr(data-hint); display: block; font-size: 0.6rem; font-weight: 400; color: #8a93a6; margin-top: 2px; }
+  .pads .act, .pads .phone-keys button { flex-direction: column; }
+}
+
+.app-dialog .controls-fields { display: block; max-height: 62vh; overflow-y: auto; padding-right: 4px; }
+.app-dialog .controls-fields label { display: block; width: 100%; margin: 0 0 14px; }
+.app-dialog .controls-fields label.inline { display: flex; align-items: center; gap: 8px; }
+.app-dialog .controls-fields input[type="range"], .app-dialog .controls-fields select { display: block; width: 100%; margin-top: 6px; }
+.app-dialog .controls-fields #vib-test { width: 100%; height: 40px; margin: 0 0 8px; }
