        <TextView android:id="@+id/t_count" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingLeft="8dp" android:textColor="#FFB7AEFF" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/t_add" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="＋" android:textSize="18sp" android:textColor="#FFFFFFFF" android:paddingLeft="14dp" android:paddingRight="14dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:background="@drawable/w_btn_accent" />
    </LinearLayout>

